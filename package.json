{
    "name": "tokentally",
    "version": "0.2.15",
    "private": true,
    "description": "Public token leaderboard for AI builders — TanStack Start + Hono API on Cloudflare Workers + D1.",
    "type": "module",
    "scripts": {
        "build": "pnpm build:css && pnpm build:reporter && vite build",
        "build:css": "tailwindcss -i src/styles/tailwind.css -o src/styles/app.css --minify",
        "build:css:watch": "tailwindcss -i src/styles/tailwind.css -o src/styles/app.css --watch",
        "build:reporter": "pnpm --filter tokenmaxer build",
        "brand:assets": "node scripts/gen-brand-assets.mjs",
        "dev": "pnpm build:css && pnpm build:reporter && concurrently -k -n css,vite -c cyan,magenta \"pnpm build:css:watch\" \"vite dev\"",
        "preview": "pnpm build:css && vite preview",
        "deploy": "pnpm build && wrangler deploy",
        "deploy:preview": "pnpm build && wrangler versions upload",
        "cf-typegen": "wrangler types",
        "prepare": "pnpm build",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit && tsc -p reporter/tsconfig.json --noEmit",
        "lint": "oxlint",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "check": "pnpm coverage && pnpm lint && pnpm fmt:check && pnpm typecheck",
        "db:migrate:local": "wrangler d1 migrations apply tokentally --local",
        "db:migrate": "wrangler d1 migrations apply tokentally --remote",
        "release": "commit-and-tag-version"
    },
    "dependencies": {
        "@cf-wasm/resvg": "0.4.0",
        "@tanstack/react-query": "5.103.1",
        "@tanstack/react-router": "1.170.38",
        "@tanstack/react-start": "1.168.56",
        "hono": "^4.13.8",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.56.0",
        "@cloudflare/workers-types": "^5.20260920.1",
        "@tailwindcss/cli": "^4.3.3",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "5.0.1",
        "commit-and-tag-version": "^13.2.1",
        "concurrently": "^10.0.5",
        "esbuild": "^0.28.2",
        "eslint-plugin-crap": "^0.1.3",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "8.3.0",
        "vitest": "^5.0.1",
        "wrangler": "^4.135.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.4.2",
    "commit-and-tag-version": {
        "bumpFiles": [
            {
                "filename": "package.json",
                "type": "json"
            },
            {
                "filename": "reporter/package.json",
                "type": "json"
            }
        ],
        "packageFiles": [
            {
                "filename": "package.json",
                "type": "json"
            }
        ],
        "releaseCommitMessageFormat": "chore(release): {{currentTag}} [skip ci]"
    }
}
